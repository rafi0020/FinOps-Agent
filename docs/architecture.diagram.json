    {
      "dot": "emerald",
      "title": "Agent loop",
      "items": [
        "A run is its own queue row, claimed under a lease",
        "The model picks one tool per step; steps are committed as they finish",
        "Model-written SQL runs as a read-only role in a read-only transaction"
      ]
    },
    {
      "dot": "amber",
      "title": "Model provider",
      "items": [
        "Optional: the built-in script runs without one",
