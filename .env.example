# FinOps Agent configuration. Copy to .env; every value has a working default for local use.

# --- Secrets (change for anything that is not a local demo) ---
SECRET_KEY=                      # encrypts provider keys saved from the UI. Set a long random value;
                                 # the built-in default is public and only suitable for a local demo
POSTGRES_PASSWORD=postgres
FINOPS_OWNER_PASSWORD=finops_owner
FINOPS_APP_PASSWORD=finops_app
FINOPS_RO_PASSWORD=finops_ro

# --- Network (published on the host) ---
API_PORT=8110                    # API docs and /metrics at http://127.0.0.1:8110/docs (8100 is taken on some machines)
WEB_BIND=127.0.0.1               # address the web UI listens on: plain HTTP, put TLS in front before widening (0.0.0.0)

# --- Accounts ---
SEED_DEMO=true                   # create the two demo organisations, six demo users and the demo data
COOKIE_SECURE=false              # true behind HTTPS
ALLOW_SIGNUP=true                # false to stop new organisations signing up
CORS_ORIGINS=http://localhost:3100

# --- LLM (see docs/PROVIDERS.md for every provider) ---
LLM_PROVIDER=stub                # openai_compat | anthropic | ollama | stub
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_PRICE_INPUT_PER_MTOK=3.0     # USD per million tokens, used for cost estimates and budgets
LLM_PRICE_OUTPUT_PER_MTOK=15.0
ALLOW_PRIVATE_LLM_URLS=true      # false on a shared deployment (blocks base URLs on private networks)

# --- Agent budgets ---
RUN_MAX_STEPS=25
RUN_MAX_TOKENS=200000
RUN_MAX_SECONDS=300
RUN_MAX_COST_USD=1.00
ORG_DAILY_COST_USD=20.00
GLOBAL_DAILY_COST_USD=200.00     # all organisations together
ORG_MAX_CONCURRENT_RUNS=5

# --- Scale ---
WORKER_CONCURRENCY=4
OTEL_EXPORTER_OTLP_ENDPOINT=     # set to export traces, e.g. AgentOps at http://host.docker.internal:3200 (its web port also serves /v1/traces), or a collector on :4318
OTEL_EXPORTER_OTLP_HEADERS=      # e.g. Authorization=Bearer ak_... (an AgentOps ingestion key)
OTEL_CAPTURE_CONTENT=false       # true also sends prompts, answers and tool arguments, secret-masked
